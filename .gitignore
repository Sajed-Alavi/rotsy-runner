# -----------------------------------------------------------------------------
# Secrets — NEVER commit real environment files or runner credentials.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
# A registered runner's identity and credential (rrt_…), and any enrollment
# token (rre_…) saved to a file for `register --token-file`.
credential
*.credential
runner.json
enrollment-token*
*.token

# -----------------------------------------------------------------------------
# Local AI-assistant config — machine-specific, not part of the project.
# -----------------------------------------------------------------------------
.claude/
AGENTS.md

# -----------------------------------------------------------------------------
# Runner state — installed scanners, vulnerability databases, downloads.
# All of it is delivered by the Rotsy server at runtime; none of it is source.
# (`data/` is the default data dir when running from a checkout.)
# -----------------------------------------------------------------------------
data/
/var/
tools/
!src/rotsy_runner/tools/
downloads/
*.partial
# Scanner binaries and database archives, if one is ever dropped in the tree.
trivy
grype
*.tar.gz
*.tar.zst
*.db
!tests/**/*.db

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.log

# -----------------------------------------------------------------------------
# Release output (scripts/build-release.sh)
# -----------------------------------------------------------------------------
release/
SHA256SUMS

# -----------------------------------------------------------------------------
# Editor / OS
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml
