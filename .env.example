# rotsy-runner configuration. Every setting is optional; the defaults are the
# secure ones. Copy to /etc/rotsy-runner/env (systemd) or pass with --env-file
# (docker). The runner's identity and credential are NOT configured here —
# `rotsy-runner register` writes them into the data directory.

# Where state, installed tools and scanner caches live (0700, runner-owned).
ROTSY_RUNNER_DATA_DIR=/var/lib/rotsy-runner

# Verify the Rotsy server's TLS certificate. Keep true in production.
ROTSY_RUNNER_TLS_VERIFY=true
# CA bundle for a server certificate issued by a private CA.
ROTSY_RUNNER_CA_FILE=

# Plain-http server URLs are refused unless this is true (local test setups only).
ROTSY_RUNNER_ALLOW_INSECURE_HTTP=false

# Jobs run at once (1-32). Trivy runs are serialised regardless.
ROTSY_RUNNER_CONCURRENCY=1

# How long SIGTERM / SHUTDOWN waits for running scans before handing them back.
ROTSY_RUNNER_SHUTDOWN_GRACE_SECONDS=60

# Wall clock for one scanner invocation (capped by the job's own timeout).
ROTSY_RUNNER_SCAN_TIMEOUT_SECONDS=900

# DEBUG | INFO | WARNING | ERROR. Secrets are redacted at every level.
ROTSY_RUNNER_LOG_LEVEL=INFO

# First-start registration for containers (optional). With both set and no
# identity in the data dir, `rotsy-runner run` registers itself once. The
# token is one-time and short-lived; remove it after the first start.
ROTSY_SERVER_URL=
ROTSY_ENROLLMENT_TOKEN=
